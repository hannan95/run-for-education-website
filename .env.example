# Local dev: SQLite, zero setup. Production (Vercel): switch the datasource
# provider in prisma/schema.prisma to "postgresql" and point this at a hosted
# Postgres instance (e.g. a free Neon or Supabase project).
DATABASE_URL="file:./dev.db"

# Shared secret for the admin views (/api/admin/*, public/admin.html).
# Generate one yourself, e.g.: openssl rand -hex 24
ADMIN_TOKEN=

# Confirmation emails via Resend (resend.com). Leave blank locally —
# registration still works, it just skips sending the email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Run for Education <no-reply@runforeducation.pk>"

# Payment gateway credentials go here once a merchant account exists
# (JazzCash / Easypaisa direct integration, or Safepay / PayFast for cards).
# Nothing in this codebase reads these yet — see README "Backend setup".
